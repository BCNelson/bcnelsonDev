{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "nodenext",
    "noEmit": true,
    // Node runs index.ts directly by stripping types, so only allow
    // syntax that stripping can handle.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
